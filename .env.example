# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker compose up -d db exposes it on 5433)
DATABASE_URL="postgresql://taxapp:taxapp_dev_only@localhost:5433/taxapp?schema=public"

# Public base URL, used in e-mail links and metadata
APP_URL="http://localhost:3000"

# 32-byte key, base64. Encrypts TOTP secrets and NIC numbers at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Where uploaded documents are stored (outside the web root, never served statically)
STORAGE_DIR="./.storage"

# E-mail delivery is not implemented yet: messages are written to the server log.
# (Implement EmailProvider in lib/email.ts to send them.)
EMAIL_FROM="Ayakara <no-reply@localhost>"

# Rate limits on sign-in, registration, password reset, 2FA, uploads and the public calculator.
# Set to "false" only for local development; leave on in production.
RATE_LIMIT_ENABLED="true"

# Comma-separated e-mail addresses promoted to ADMIN by the seed script
ADMIN_EMAILS="admin@example.lk"
# Optional: lets the seed create those admin accounts with this password
# SEED_ADMIN_PASSWORD=""
